# Copy this file to .env and adjust.
PORT=4000

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file lives. On Railway/Render mount a volume and point this at it,
# otherwise the demo data is simply re-created at every restart (which is fine for a demo).
DATABASE_PATH=./data/hallfinder.db

# Comma separated list of front-end URLs allowed to call this API ("*" allows everyone, fine for a demo).
CLIENT_ORIGIN=*

# Time zone of the school. Timetables and reminders are calculated in this zone.
SCHOOL_TZ=Africa/Douala

# Name shown by the API (the front end has its own NEXT_PUBLIC_SCHOOL_NAME).
SCHOOL_NAME=Horizon International College
